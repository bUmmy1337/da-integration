{
  "schemaVersion": 1,
  "id": "daintegrate",
  "version": "${version}",
  "name": "Donation Alerts Integrate",
  "description": "Runs chat messages and commands when you get a donation, subscription or Twitch reward on Donation Alerts. Press '=' to open the menu.",
  "authors": [
    "bUmmy1337"
  ],
  "contact": {
    "sources": "https://github.com/bummy1337/da-integration",
    "issues": "https://github.com/bummy1337/da-integration/issues/"
  },
  "license": "MIT",
  "icon": "assets/daintegrate/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "net.bummy1337.daintegrate.fabric.ClientEntryPoint"
    ]
  },
  "depends": {
    "fabricloader": ">=0.19.5",
    "fabric-api": "*",
    "minecraft": ">=26.3",
    "java": ">=25"
  },
  "mixins": [
    "daintegrate.mixins.json"
  ]
}
